  MK --> MK2["庆祝错误（Google X）"]
  MK --> MK3["布置促进挑战与成长的任务"]

  IT --> FT
  IT --> PP
  IT --> DT
  IT --> EA

  PP --> CS
  PP --> MK
  CS1 -. 汇总 .-> NS
  CS2 -. 汇总 .-> NS
